# Local configuration. Copy to `.env` at the repository root and fill in.
# `pnpm dev`, the test suites, `pnpm preview`, and the local acceptance harnesses
# all read that one file; deployed Workers use `wrangler secret put` instead.
# What each name does: README.md → Local configuration.
# Generate keys and secrets with: openssl rand -base64 32

# Optional for tests. Leave empty rather than fake: the two realtime integration
# tests skip without it, and a fake key makes one of them fail.
NUXT_ABLY_API_KEY=

NUXT_GRAPHICS_ADMIN_TOKEN=

# Required unless running a `:bypass` launcher.
NUXT_BETTER_AUTH_SECRET=

# Keep set locally: it is how a fresh checkout and the local acceptance harnesses
# create an account. Blank is fine only under a `:bypass` launcher.
NUXT_ADMIN_BOOTSTRAP_TOKEN=

NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY=

NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY=
NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Optional JSON keyring during rotation, e.g. {"1":"OLD_BASE64_KEY"}
NUXT_MELEE_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
