# The local configuration for this checkout, and the only file that holds any.
#
# Copy this to `.env` at the repository root and fill in the names below. One
# file reaches all three ways this application runs locally:
#
#   `pnpm dev` and the test suites — Nuxt loads `.env` into `process.env` before
#   anything reads runtimeConfig, which is where every `NUXT_`-prefixed name here
#   ends up. A checkout that cannot supply the required ones is told so once, at
#   boot, rather than by a 503 per surface (`build/localConfiguration.ts`, #130).
#
#   `pnpm preview` — wrangler resolves `.env` against the directory of its config
#   file, and the preview passes `--config .output/server/wrangler.json`, so the
#   file it opens is `.output/server/.env`. `scripts/stage-preview-secrets.mjs`
#   copies this one across before wrangler starts (#274). Edit the root copy,
#   never the staged one: the next build wipes that directory and the next
#   preview writes over it, and it will work right up until it silently does not.
#
#   The local acceptance harnesses — their own `node` processes, so they read
#   this file directly and refuse to open an installation they can see is
#   unconfigured (`scripts/graphics-acceptance/local-configuration.mjs`). Three
#   names are load-bearing for them: `NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY`,
#   `NUXT_BETTER_AUTH_SECRET` and `NUXT_ADMIN_BOOTSTRAP_TOKEN`.
#
# There was a second file, `.dev.vars`, on the recorded belief that wrangler
# would not read this one. It does — measured against the built Worker — and it
# reads exactly one of the two, preferring that one, so while both existed the
# three `NUXT_MELEE_*` names below reached a previewed Worker through nothing at
# all (#412).
#
# A deployed installation reads no file: those names are Worker secrets, set with
# `wrangler secret put` — see the README.

# Ably Realtime API key (server-side).
# Optional for the test suites. Without it the integration suite still passes, and
# announces once that it has skipped the two tests that publish or mint a realtime
# token; a fake key would not help, because those reach the real service. Leave it
# empty rather than fabricating one: a well-formed fake reads as configured here, and
# the run then goes half green — the token test signs locally and passes, while the
# Screen-command test gets Ably's 404 and fails carrying the explanation.
NUXT_ABLY_API_KEY=

# Graphics Administrator capability used for protected graphics operations.
NUXT_GRAPHICS_ADMIN_TOKEN=

# Better Auth secret: signs session tokens and hashes (#393).
# Required as of #396, when /api/** began denying by default: without this, sign-in
# and every authenticated route answer 503 naming this name, so a checkout that has
# not set it can reach nothing. `pnpm dev` warns once at boot if it is blank.
# May remain blank only when NUXT_LOCAL_AUTH_BYPASS=true under `pnpm dev`.
# Generate with: openssl rand -base64 32
NUXT_BETTER_AUTH_SECRET=

# Development-only Better Auth bypass. Set exactly `true` to enter the app as the
# stable Local Developer User without a Better Auth secret, bootstrap token, account,
# or sign-in. Each browser still receives its own local Session for authoring leases.
# Leave blank (or set false) to exercise real authentication. Never bind a bypassed
# dev server beyond loopback: every machine that can reach it can use the application.
NUXT_LOCAL_AUTH_BYPASS=

# First-admin bootstrap (#394). While this is set, POST /api/bootstrap/ensure-admin
# creates or resets an admin account for whoever presents it in the
# x-admin-bootstrap-token header; while it is blank, that route answers 503 and
# nothing else changes. Deployed installations arm it for the one call and delete
# it again — see the README's Worker secrets section. Locally it is fine to leave
# set, which is what keeps the path exercised.
# Required locally as of #396 for a different reason from the secret above: with a
# boundary in front of /api/**, this route is the only way a fresh checkout — or a
# local acceptance harness — gets an account to sign in with at all.
# May remain blank only when NUXT_LOCAL_AUTH_BYPASS=true under `pnpm dev`; preview
# and the acceptance harnesses still use real authentication.
# Generate with: openssl rand -base64 32
NUXT_ADMIN_BOOTSTRAP_TOKEN=

# 32-byte base64 HMAC key used to derive revocable Screen Output asset capabilities.
# Generate the key with: openssl rand -base64 32
NUXT_SCREEN_OUTPUT_CAPABILITY_SIGNING_KEY=

# Melee client-secret encryption (server-side only)
# Generate the key with: openssl rand -base64 32
NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY=
NUXT_MELEE_CREDENTIAL_ENCRYPTION_KEY_VERSION=1
# Optional JSON keyring retained temporarily during rotation, for example:
# NUXT_MELEE_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS={"1":"OLD_BASE64_KEY"}
NUXT_MELEE_CREDENTIAL_ENCRYPTION_PREVIOUS_KEYS=
