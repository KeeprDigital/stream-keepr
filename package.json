{
	"name": "stream-keepr",
	"type": "module",
	"private": true,
	"packageManager": "pnpm@11.10.0+sha512.0b7f8b98060031904c017e3a41eb187a16d40eeb829b95c4f8cb03681761fc4ab53dd219115b9b447f4dce1a05a214764461e7d3703392a9f32f9511ce8c86c8",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev",
		"dev:local": "nuxt dev --host 0.0.0.0",
		"typecheck": "nuxt typecheck",
		"generate": "nuxt generate",
		"preview": "pnpm build && pnpm db:migrate:local:built && wrangler dev --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"worker:dry-run": "wrangler deploy --dry-run --config .output/server/wrangler.json --outdir .output/wrangler-dry-run",
		"deploy": "CLOUDFLARE_ENV=production pnpm build && pnpm worker:dry-run && pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json && pnpm deploy:verify",
		"deploy:verify": "bash scripts/deploy-verify.sh",
		"deploy:validator": "wrangler deploy --config workers/silent-video-validator/wrangler.jsonc",
		"postinstall": "nuxt prepare",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"db:generate": "nuxt db generate",
		"db:migrate": "nuxt db migrate",
		"db:migrate:local:built": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"db:migrations:list:remote": "wrangler d1 migrations list DB --remote --config .output/server/wrangler.json",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
		"test": "pnpm test:unit:run && pnpm test:nuxt:run && pnpm test:integration:run && pnpm test:browser:still-images && pnpm test:browser:silent-video",
		"test:watch": "vitest",
		"test:unit": "vitest",
		"test:unit:run": "vitest run",
		"test:nuxt": "vitest --config vitest.nuxt.config.ts",
		"test:nuxt:run": "vitest run --config vitest.nuxt.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"test:integration:run": "vitest run --config vitest.integration.config.ts",
		"test:browser:still-images": "node scripts/run-still-image-browser-acceptance.mjs",
		"test:browser:still-images:deployed": "node scripts/run-still-image-browser-acceptance.mjs --deployed",
		"test:browser:silent-video": "node scripts/run-silent-video-browser-acceptance.mjs",
		"test:browser:silent-video:deployed": "node scripts/run-silent-video-browser-acceptance.mjs --deployed",
		"test:validator:silent-video": "node scripts/run-silent-video-validator-acceptance.mjs",
		"test:validator:silent-video:deployed": "node scripts/run-silent-video-validator-acceptance.mjs --deployed",
		"test:e2e": "pnpm test:integration:run",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage && vitest run --coverage --config vitest.nuxt.config.ts"
	},
	"dependencies": {
		"@jsquash/jpeg": "1.6.0",
		"@jsquash/webp": "1.5.0",
		"@nuxt/eslint": "1.16.0",
		"@nuxt/fonts": "0.14.0",
		"@nuxt/image": "2.0.0",
		"@nuxt/ui": "4.10.0",
		"@nuxthub/core": "0.10.8",
		"@pinia/nuxt": "1.0.1",
		"@vueuse/core": "14.3.0",
		"@vueuse/nuxt": "14.3.0",
		"ably": "2.25.0",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"echarts": "^6.1.0",
		"fontkitten": "1.0.3",
		"mana-font": "1.18.0",
		"nuxt": "4.5.0",
		"nuxt-echarts": "^1.0.1",
		"pinia": "4.0.2",
		"tailwindcss": "4.3.3",
		"three": "^0.185.1",
		"vue": "3.5.40",
		"vue-draggable-plus": "0.6.1",
		"vue-echarts": "^8.0.1",
		"vue-router": "5.2.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.2.0",
		"@cloudflare/containers": "^0.3.7",
		"@iconify-json/lucide": "1.2.118",
		"@libsql/client": "0.17.4",
		"@nuxt/eslint-config": "1.16.0",
		"@nuxt/test-utils": "4.0.3",
		"@prettier/plugin-xml": "3.4.2",
		"@scryfall/api-types": "1.0.0-alpha.4",
		"@types/node": "26.1.1",
		"@types/three": "^0.185.1",
		"@typescript-eslint/parser": "8.65.0",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"@vue/test-utils": "2.4.11",
		"drizzle-kit": "0.31.10",
		"eslint": "10.7.0",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-format": "2.0.1",
		"happy-dom": "20.11.0",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"vue-tsc": "3.3.7",
		"wrangler": "4.113.0"
	}
}
