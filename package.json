{
	"name": "stream-keepr",
	"type": "module",
	"version": "1.3.1",
	"private": true,
	"packageManager": "pnpm@11.21.0+sha512.521705bce689924eac72f5a3587122f362689ef6571e55ba80076fd637c11132ecffada26fad4ea79c485bfddbfd3d5a2a5b05805a77e893de71ec8a6cca3bb1",
	"scripts": {
		"verify": "node scripts/verify.mjs",
		"verify:quick": "node scripts/verify.mjs --quick",
		"build": "nuxt build",
		"dev": "node scripts/reap-workerd.mjs && pnpm db:migrate && nuxt dev",
		"dev:bypass": "node scripts/reap-workerd.mjs && pnpm db:migrate && STREAM_KEEPR_LOCAL_AUTH_BYPASS=true nuxt dev",
		"dev:local": "node scripts/reap-workerd.mjs && pnpm db:migrate && nuxt dev --host 0.0.0.0",
		"dev:local:bypass": "node scripts/reap-workerd.mjs && pnpm db:migrate && STREAM_KEEPR_LOCAL_AUTH_BYPASS=true nuxt dev --host 0.0.0.0",
		"reap": "node scripts/reap-workerd.mjs",
		"typecheck": "nuxt prepare && pnpm typecheck:app && pnpm typecheck:test",
		"typecheck:app": "vue-tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsc/app.tsbuildinfo",
		"typecheck:test": "vue-tsc --noEmit -p tsconfig.test.json --incremental --tsBuildInfoFile node_modules/.cache/tsc/test.tsbuildinfo",
		"generate": "nuxt generate",
		"preview": "node scripts/reap-workerd.mjs && pnpm build && pnpm db:migrate:local:built && node scripts/stage-preview-secrets.mjs && wrangler dev --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"preview:bypass": "STREAM_KEEPR_LOCAL_AUTH_BYPASS=true pnpm preview",
		"worker:dry-run": "node scripts/worker-dry-run.mjs",
		"worker:smoke": "node scripts/reap-workerd.mjs && node scripts/worker-smoke.mjs",
		"deploy": "pnpm build && pnpm worker:dry-run && pnpm worker:smoke && pnpm db:migrate:remote && wrangler deploy --config .output/server/wrangler.json && pnpm deploy:verify",
		"deploy:verify": "bash scripts/deploy-verify.sh",
		"deploy:validator": "wrangler deploy --config workers/silent-video-validator/wrangler.jsonc",
		"postinstall": "nuxt prepare",
		"lint": "eslint . --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
		"lint:fix": "eslint . --fix --cache --cache-strategy content --cache-location node_modules/.cache/eslint/",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "wrangler d1 migrations apply DB --local --config wrangler.dev.jsonc < /dev/null",
		"db:migrate:local:built": "wrangler d1 migrations apply DB --local --config .output/server/wrangler.json --persist-to .wrangler/state/built-worker",
		"db:migrations:list:remote": "wrangler d1 migrations list DB --remote --config .output/server/wrangler.json",
		"db:migrate:remote": "wrangler d1 migrations apply DB --remote --config .output/server/wrangler.json",
		"test": "node scripts/verify.mjs --tests",
		"test:changed": "vitest run --changed origin/main --passWithNoTests && vitest run --config vitest.nuxt.config.ts --changed origin/main --passWithNoTests",
		"test:unit": "vitest",
		"test:unit:coverage": "vitest run --coverage",
		"test:nuxt": "vitest --config vitest.nuxt.config.ts",
		"test:nuxt:coverage": "vitest run --config vitest.nuxt.config.ts --coverage",
		"test:local-auth": "vitest run --config vitest.local-auth.config.ts",
		"test:integration": "vitest --config vitest.integration.config.ts",
		"accept": "node scripts/accept.mjs"
	},
	"dependencies": {
		"@jsquash/jpeg": "1.6.0",
		"@jsquash/webp": "1.5.0",
		"@nuxt/fonts": "0.14.0",
		"@nuxt/image": "2.1.0",
		"@nuxt/ui": "4.10.0",
		"@pinia/nuxt": "1.0.1",
		"@vueuse/core": "14.4.0",
		"@vueuse/nuxt": "14.4.0",
		"ably": "2.27.0",
		"better-auth": "1.6.29",
		"drizzle-orm": "0.45.2",
		"drizzle-zod": "0.8.3",
		"echarts": "6.1.0",
		"fontkitten": "1.0.3",
		"mana-font": "1.18.0",
		"nuxt": "4.5.2",
		"nuxt-echarts": "1.0.1",
		"pinia": "4.0.2",
		"tailwindcss": "4.3.3",
		"three": "0.185.1",
		"vue": "3.5.41",
		"vue-draggable-plus": "0.6.1",
		"vue-echarts": "8.1.0",
		"vue-router": "5.2.0",
		"zod": "4.4.3"
	},
	"devDependencies": {
		"@antfu/eslint-config": "9.3.0",
		"@cloudflare/containers": "0.3.7",
		"@iconify-json/lucide": "1.2.123",
		"@iconify-json/simple-icons": "1.2.93",
		"@libsql/client": "0.17.4",
		"@nuxt/eslint": "1.17.0",
		"@nuxt/eslint-config": "1.17.0",
		"@nuxt/test-utils": "4.1.0",
		"@prettier/plugin-xml": "3.4.2",
		"@scryfall/api-types": "1.0.0-alpha.4",
		"@types/node": "26.2.0",
		"@types/three": "0.185.4",
		"@typescript-eslint/parser": "8.67.0",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"@vue/test-utils": "2.4.11",
		"drizzle-kit": "0.31.10",
		"esbuild": "0.28.2",
		"eslint": "10.8.1",
		"eslint-plugin-drizzle": "0.2.3",
		"eslint-plugin-format": "2.0.1",
		"happy-dom": "20.11.2",
		"typescript": "6.0.3",
		"vitest": "4.1.10",
		"vue-tsc": "3.3.9",
		"wrangler": "4.120.1"
	}
}
