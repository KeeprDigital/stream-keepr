{
	// The program ESLint builds for its one type-aware rule, which runs on
	// server and shared code only (eslint.config.mjs). Keep it to what those
	// files need: every tree added here is parsed on every cold lint.
	"extends": "./tsconfig.json",
	"include": [
		".nuxt/nuxt.d.ts",
		".nuxt/nuxt.node.d.ts",
		"server/**/*.ts",
		"shared/**/*.ts"
	],
	"exclude": [
		"node_modules",
		".output",
		"server/db/migrations"
	]
}
