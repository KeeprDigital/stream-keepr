{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nitro and NuxtHub add the Worker entrypoint, assets, name, D1, and KV
	// bindings to .output/server/wrangler.json. Keep each binding in one source.
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	"r2_buckets": [
		{
			"binding": "GRAPHICS_ASSET_STAGING",
			"bucket_name": "stream-graphics-asset-staging"
		},
		{
			"binding": "GRAPHICS_ASSET_CANONICAL",
			"bucket_name": "stream-graphics-asset-canonical"
		}
	],
	// Graphics Asset Library retention. Deadlines are evaluated inside the
	// library, so this only needs to run often enough to keep queues short.
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"services": [
		{
			// Trusted silent-video playback validation runtime. Deploy the
			// validator first (pnpm deploy:validator) so this binding resolves.
			"binding": "SILENT_VIDEO_PLAYBACK_VALIDATOR",
			"service": "stream-silent-video-validator"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"persist": true
		}
	}
}
