{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Nitro builds .output/server/wrangler.json from this file, adding the Worker
	// entrypoint, assets, and name. Every deployed binding and its production ID
	// is declared here and nowhere else. Wrangler resolves path fields
	// relative to the generated file, so `migrations_dir` climbs back out of
	// .output/server.
	"compatibility_date": "2026-07-16",
	"compatibility_flags": ["nodejs_compat", "no_nodejs_compat_v2"],
	// The production hostname. The keepr.digital zone lives on the same
	// Cloudflare account, so wrangler keeps this custom domain attached on
	// every deploy; it was previously attached only in the dashboard, which
	// left the repo unable to name its own installation (#189).
	"routes": [
		{ "pattern": "stream.keepr.digital", "custom_domain": true }
	],
	"d1_databases": [
		{
			"binding": "DB",
			"database_id": "26830437-975a-4378-a135-acfc01ea89ae",
			// Production D1 records its applied migrations in this table. Under
			// any other name every migration would replay from 0000 and fail
			// mid-deploy.
			"migrations_table": "_hub_migrations",
			"migrations_dir": "../../server/db/migrations/sqlite"
		}
	],
	"kv_namespaces": [
		{ "binding": "KV", "id": "a15cf281b12d43e4b5479baf8b69b587" }
	],
	"r2_buckets": [
		{
			"binding": "GRAPHICS_ASSET_STAGING",
			"bucket_name": "stream-graphics-asset-staging"
		},
		{
			"binding": "GRAPHICS_ASSET_CANONICAL",
			"bucket_name": "stream-graphics-asset-canonical"
		}
	],
	// Graphics Asset Library retention. Deadlines are evaluated inside the
	// library, so this only needs to run often enough to keep queues short.
	"triggers": {
		"crons": ["17 * * * *"]
	},
	"services": [
		{
			// Trusted silent-video playback validation runtime. Deploy the
			// validator first (pnpm deploy:validator) so this binding resolves.
			"binding": "SILENT_VIDEO_PLAYBACK_VALIDATOR",
			"service": "stream-silent-video-validator"
		}
	],
	"observability": {
		"enabled": true,
		"logs": {
			"enabled": true,
			"head_sampling_rate": 1,
			"invocation_logs": true,
			"persist": true
		},
		"traces": {
			"enabled": true,
			"head_sampling_rate": 0.05,
			"persist": true
		}
	}
}
